{
  "name": "lighting-network-analyzer",
  "description": "Lux Link lighting network dashboard and LAN server",
  "author": "Brandon Horner",
  "main": "electron/main.cjs",
  "version": "0.1.5",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "start:lan": "pnpm run desktop:web && node scripts/start-lan.mjs",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "desktop": "pnpm run desktop:web && node scripts/run-desktop.mjs",
    "desktop:web": "vite build --config desktop/vite.config.ts",
    "desktop:build": "pnpm run desktop:web && electron-builder --config electron-builder.json",
    "desktop:test": "node --test tests/desktop-server.test.cjs tests/manual-devices.test.mjs tests/updates.test.mjs tests/signals.test.cjs tests/node-poller.test.cjs tests/netron-api.test.cjs tests/proplex-web.test.cjs",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "electron": "44.1.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "electron-builder": "26.15.3",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

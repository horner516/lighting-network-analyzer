{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "start:lan": "node scripts/start-lan.mjs",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "desktop": "node scripts/run-desktop.mjs",
    "desktop:build": "pnpm run build && electron-builder --config electron-builder.json",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "electron": "^33.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "electron-builder": "^25.1.8",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.luxlink.lighting-network-analyzer",
    "productName": "Lighting Network Analyzer",
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "app/**/*",
      "components/**/*",
      "hooks/**/*",
      "lib/**/*",
      "public/**/*",
      "scripts/**/*",
      "electron/**/*",
      "package.json",
      "next-env.d.ts",
      "tsconfig.json",
      "components.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "horner516",
        "repo": "lighting-network-analyzer"
      }
    ]
  }
}

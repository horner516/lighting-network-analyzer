{
  "appId": "com.luxlink.lighting-network-analyzer",
  "productName": "Lighting Network Analyzer",
  "directories": {
    "output": "desktop-dist"
  },
  "files": [
    "desktop-web/**/*",
    "public/app-icon.*",
    "electron/**/*",
    "package.json"
  ],
  "asar": true,
  "npmRebuild": false,
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "icon": "public/app-icon.ico",
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "artifactName": "Lighting-Network-Analyzer-${version}-windows-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "public/app-icon.ico",
    "uninstallerIcon": "public/app-icon.ico",
    "installerHeaderIcon": "public/app-icon.ico"
  },
  "mac": {
    "category": "public.app-category.utilities",
    "icon": "public/app-icon.icns",
    "target": ["dmg", "zip"],
    "artifactName": "Lighting-Network-Analyzer-${version}-mac-${arch}.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "horner516",
      "repo": "lighting-network-analyzer"
    }
  ]
}

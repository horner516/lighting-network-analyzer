{
  "appId": "com.luxlink.lighting-network-analyzer",
  "productName": "Lighting Network Analyzer",
  "directories": {
    "output": "desktop-dist"
  },
  "files": [
    "app/**/*",
    "components/**/*",
    "hooks/**/*",
    "lib/**/*",
    "public/**/*",
    "scripts/**/*",
    "electron/**/*",
    "package.json",
    "vite.config.ts",
    "next.config.ts",
    ".openai/hosting.json",
    "next-env.d.ts",
    "tsconfig.json",
    "components.json",
    "node_modules"
  ],
  "asar": true,
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "icon": "public/app-icon.ico",
    "target": "nsis",
    "artifactName": "${productName}-${version}-win-${arch}.${ext}"
  },
  "nsis": {
    "installerIcon": "public/app-icon.ico",
    "uninstallerIcon": "public/app-icon.ico",
    "installerHeaderIcon": "public/app-icon.ico"
  },
  "mac": {
    "icon": "public/app-icon.icns",
    "target": ["dmg", "zip"]
  },
  "publish": [
    {
      "provider": "github",
      "owner": "horner516",
      "repo": "lighting-network-analyzer"
    }
  ]
}
